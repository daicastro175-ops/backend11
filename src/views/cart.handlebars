<a href="/">
    <button>Volver al inicio</button>
</a>

<h1>Mi carrito</h1>

{{#if products.length}}

    {{#each products}}

        <h2>{{product.title}}</h2>

        <p>Precio: ${{product.price}}</p>

        <p>Cantidad: {{quantity}}</p>

        <hr>

    {{/each}}

{{else}}

    <p>El carrito está vacío.</p>

{{/if}}