<h1>Productos en tiempo real</h1>


<div id="productsContainer">

{{#each products}}

<div class="product-card">

<h3>{{title}}</h3>

<p>{{description}}</p>

<p>Precio: ${{price}}</p>

<p>Stock: {{stock}}</p>

<p>Categoría: {{category.name}}</p>

</div>

{{/each}}

</div>


<script src="/socket.io/socket.io.js"></script>
<script src="/js/realTimeProducts.js"></script>